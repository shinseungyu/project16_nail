# 이 파일을 복사해 .env.local 로 저장하고 값을 채우세요. (.env.local 은 git 에 안 올라갑니다)

# ── 발행 대상 (nailstartup.com 발행 API) ──
BLOG_API_BASE_URL=https://www.nailstartup.com/api/studio
# Vercel 환경변수 BLOG_API_TOKEN 과 똑같은 값 (24자 이상)
BLOG_API_TOKEN=

# ── 상위글 검색 ──
# 기본은 이 PC 의 크롬으로 구글 검색(무료). 캡차가 뜨면 창이 열립니다.
CHROME_HEADLESS=true

# DataForSEO(유료) — 기본 꺼짐. 켜도 하루 사용액 한도를 넘으면 호출하지 않습니다.
DATAFORSEO_ENABLED=false
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_DAILY_BUDGET_USD=1

# ── 구글 색인 요청 바로가기 (Search Console 속성) ──
# 도메인 속성이면 sc-domain:nailstartup.com / URL 접두어 속성이면 https://www.nailstartup.com/
GSC_PROPERTY=sc-domain:nailstartup.com
